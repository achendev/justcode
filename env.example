# JustCode Server Configuration
# Copy this file to .env and change the values if needed.

# The IP address the Flask server will listen on.
# Use 127.0.0.1 for local access only (default).
# Use 0.0.0.0 to make the server accessible from other machines on your network.
# WARNING: Using 0.0.0.0 exposes the server. Only do this on a trusted network.
FLASK_RUN_HOST=127.0.0.1

# The port the Flask server will listen on.
FLASK_RUN_PORT=5010

# Push-to-Talk Voice Dictation Configuration
# 1. Background / Stay-in-app hotkey (default: cmd_r)
DICTATION_HOTKEY_BACKGROUND=cmd_r

# 2. Foreground / Switch-to-ChatGPT hotkey (default: alt_r)
DICTATION_HOTKEY_FOREGROUND=alt_r

# Legacy single hotkey fallback (optional)
# DICTATION_HOTKEY=cmd_r

# Enable or disable the background push-to-talk keyboard listener
ENABLE_DICTATION=true

# Write a structured, rotating session trace for diagnosing timing/race issues.
# The default path is ./dictation_debug.log (2 MB, three rotated backups).
DICTATION_DEBUG_LOG=true
# DICTATION_DEBUG_LOG_PATH=/absolute/path/to/dictation_debug.log
